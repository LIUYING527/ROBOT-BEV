# ===== 大体量原始数据（不入库，通过 rsync / 软链接同步）=====
data/
bevlook_data.tar
*.tar
*.bag
*.db3

# ===== 第三方仓库（各自有独立 .git，体量巨大，单独 clone）=====
third_party/

# ===== 中间产物 / 重建结果 =====
outputs/*
!outputs/.gitkeep

# ===== arch_e2e: 代码/文档入库, 大体量权重/模型/产物不入库 =====
# (gitignore 不支持行内注释, 注释须单独成行)
# 复制来的 ckpt/backbone (可从 robot_orig_code 再复制)
arch_e2e/weights/
# VLM 权重 8.8G (用 download_vlm.sh 重下)
arch_e2e/vlm/
# obs/视频/指标/日志等产物
arch_e2e/runs/
# VLM 分片权重
*.safetensors

# 大体量二进制（即便散落在别处也不入库）
*.ply
*.glb
*.npz
*.npy
*.mp4
*.gif
*.pcd
*.bin
*.ckpt
*.pth
*.pt
*.db

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ===== 系统 / 编辑器 =====
.DS_Store
*.swp
.idea/
.vscode/

# 备份残留
*.bak

# 真机部署打包产物(1.1GB, 不提交)
deploy_pkg/
deploy_pkg.tar.gz
